#!/usr/bin/env bash
# git wrapper: `git status --porcelain` fails while the worktree's index.lock
# exists (as a crashed git can make it), like Firstmate's
# add_git_status_lock_failure; everything else is the real git.
self=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
real=""
IFS=: read -r -a dirs <<< "$PATH"
for d in "${dirs[@]}"; do
  [ "$(cd "$d" 2>/dev/null && pwd -P)" = "$self" ] && continue
  if [ -x "$d/git" ]; then real="$d/git"; break; fi
done
[ -n "$real" ] || { echo "fake git: no real git on PATH" >&2; exit 127; }
dir=$PWD prev="" status=0 porcelain=0
for a in "$@"; do
  [ "$prev" != -C ] || dir=$a
  [ "$a" != status ] || status=1
  [ "$a" != --porcelain ] || porcelain=1
  prev=$a
done
if [ "$status" = 1 ] && [ "$porcelain" = 1 ]; then
  lock=$("$real" -C "$dir" rev-parse --git-path index.lock 2>/dev/null || true)
  case "$lock" in /*|'') ;; *) lock="$dir/$lock" ;; esac
  if [ -n "$lock" ] && [ -e "$lock" ]; then
    echo "fatal: Unable to create '$lock': File exists." >&2
    exit 128
  fi
fi
exec "$real" "$@"

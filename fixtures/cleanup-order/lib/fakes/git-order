#!/usr/bin/env bash
# git wrapper: when `git worktree remove` runs, record in runtime/order.log
# whether the no-mistakes abort already happened (nm/abort.log is non-empty)
# and whether the watched process is already gone; then run the real git.
self=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
root=$(cd "$self/.." && pwd -P)
real=""
IFS=: read -r -a dirs <<< "$PATH"
for d in "${dirs[@]}"; do
  [ "$(cd "$d" 2>/dev/null && pwd -P)" = "$self" ] && continue
  if [ -x "$d/git" ]; then real="$d/git"; break; fi
done
[ -n "$real" ] || { echo "fake git: no real git on PATH" >&2; exit 127; }
case " $* " in
  *" worktree remove "*)
    [ ! -s "$root/nm/abort.log" ] || echo abort-already-happened >> "$root/runtime/order.log"
    pid=$(head -1 "$root/runtime/watch-pids" 2>/dev/null)
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then echo reap-already-happened >> "$root/runtime/order.log"; fi
    ;;
esac
exec "$real" "$@"

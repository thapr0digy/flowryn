{
  "name": "squash_merged_rebased_branch",
  "ported_from": "tests/fm-teardown.test.sh:test_squash_merged_rebased_branch_allows",
  "firstmate_matrix_row": "q2",
  "description": "The pipeline rebased the task onto a main that also edited shared.txt, then squash-merged it (refs/pull/7/head holds the rebased head). The worktree followed the rebase and sits exactly at the merged PR head, which is on no remote-tracking branch. Allowed via the merged PR.",
  "delivery_mode": "no-mistakes",
  "inputs": {
    "operation": "cleanup",
    "task_branch": "fm/task-x1",
    "kind": "ship",
    "recorded_pr_url": "https://github.com/example/repo/pull/7",
    "recorded_pr_head": "pr_head",
    "pr_url_to_record": null,
    "discard_approval": null
  },
  "forge": {
    "reachable": true,
    "pull_requests": [
      {
        "number": 7,
        "head_ref_name": "fm/task-x1",
        "state": "MERGED",
        "head": "pr_head"
      }
    ]
  },
  "expected": {
    "verdict": "allow",
    "reason_class": "merged_pr_contains_head"
  },
  "invariants": [
    {
      "check": "on_remote_tracking",
      "ref": "local_head",
      "expect": false
    },
    {
      "check": "same",
      "a": "local_head",
      "b": "pr_head",
      "expect": true
    },
    {
      "check": "same",
      "a": "origin_main",
      "b": "squash_commit",
      "expect": true
    },
    {
      "check": "content_in",
      "ref": "origin_main",
      "expect": true
    },
    {
      "check": "dirty",
      "expect": false
    }
  ]
}

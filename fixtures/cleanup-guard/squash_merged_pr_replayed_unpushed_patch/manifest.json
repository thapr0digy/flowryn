{
  "name": "squash_merged_pr_replayed_unpushed_patch",
  "ported_from": "tests/fm-teardown.test.sh:test_squash_merged_pr_allows_replayed_unpushed_patch",
  "reference_matrix_row": "n",
  "description": "A local parent commit was pushed as origin/fm/task-x1; the next local commit (feature.txt) was never pushed. The merged PR head is a different commit on origin branch pr-head that replays the same patch on main. Local HEAD is not an ancestor of the PR head, but every unpushed local commit has a patch-id present in merge-base..pr_head, so the work is contained: allowed.",
  "delivery_mode": "no-mistakes",
  "inputs": {
    "operation": "cleanup",
    "task_branch": "fm/task-x1",
    "kind": "ship",
    "recorded_pr_url": "https://github.com/example/repo/pull/7",
    "recorded_pr_head": null,
    "pr_url_to_record": null,
    "discard_approval": null
  },
  "forge": {
    "reachable": true,
    "pull_requests": [
      {
        "number": 7,
        "head_ref_name": "fm/task-x1",
        "state": "MERGED",
        "head": "pr_head"
      }
    ]
  },
  "expected": {
    "verdict": "allow",
    "reason_class": "merged_pr_contains_patches"
  },
  "invariants": [
    {
      "check": "on_remote_tracking",
      "ref": "local_head",
      "expect": false
    },
    {
      "check": "on_remote_tracking",
      "ref": "local_parent",
      "expect": true
    },
    {
      "check": "remote_branch",
      "remote": "origin",
      "branch": "fm/task-x1",
      "expect": true
    },
    {
      "check": "ancestor",
      "ref": "local_head",
      "of": "pr_head",
      "expect": false
    },
    {
      "check": "patches_in",
      "ref": "pr_head",
      "expect": true
    },
    {
      "check": "content_in",
      "ref": "origin_main",
      "expect": false
    },
    {
      "check": "dirty",
      "expect": false
    }
  ]
}

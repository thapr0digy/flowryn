{
  "name": "merged_pr_with_later_local_commit",
  "ported_from": "tests/fm-teardown.test.sh:test_merged_pr_with_later_local_commit_refuses",
  "reference_matrix_row": "k",
  "description": "The PR was recorded (pr=, pr_head=) at the first commit and later reads MERGED with that head, but the worktree then gained another commit (later.txt) that is in neither the PR head nor origin/main. The merged PR no longer covers the local work: refused.",
  "delivery_mode": "no-mistakes",
  "inputs": {
    "operation": "cleanup",
    "task_branch": "fm/task-x1",
    "kind": "ship",
    "recorded_pr_url": "https://github.com/example/repo/pull/7",
    "recorded_pr_head": "pr_head",
    "pr_url_to_record": null,
    "discard_approval": null
  },
  "forge": {
    "reachable": true,
    "pull_requests": [
      {
        "number": 7,
        "head_ref_name": "fm/task-x1",
        "state": "MERGED",
        "head": "pr_head"
      }
    ]
  },
  "expected": {
    "verdict": "refuse",
    "reason_class": "not_in_merged_pr_head"
  },
  "invariants": [
    {
      "check": "on_remote_tracking",
      "ref": "local_head",
      "expect": false
    },
    {
      "check": "ancestor",
      "ref": "pr_head",
      "of": "local_head",
      "expect": true
    },
    {
      "check": "ancestor",
      "ref": "local_head",
      "of": "pr_head",
      "expect": false
    },
    {
      "check": "patches_in",
      "ref": "pr_head",
      "expect": false
    },
    {
      "check": "content_in",
      "ref": "origin_main",
      "expect": false
    },
    {
      "check": "dirty",
      "expect": false
    }
  ]
}

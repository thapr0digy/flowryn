    "pull_requests": [
      {
        "number": 7,
        "head_ref_name": "fm/task-x1",
        "state": "MERGED",
        "head": "pr_head"
      }
    ]
  },
  "expected": {
    "verdict": "refuse",
    "reason_class": "not_in_merged_pr_head"

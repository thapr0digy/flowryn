{
  "name": "pr_check_does_not_refresh_stale_pr_head",
  "ported_from": "tests/fm-teardown.test.sh:test_pr_check_does_not_refresh_stale_pr_head",
  "firstmate_matrix_row": "o",
  "description": "PR-head recording (Firstmate fm-pr-check.sh), re-run after the worktree moved. The PR was first recorded at the feature commit (the forge head). The worktree then gained a local commit (later.txt). Re-recording the PR must take the head from the forge, so it keeps pr_head and must NOT record the newer local HEAD (exactly one head recorded). A follow-up cleanup with that record must refuse, because the later commit is not in the merged PR head.",
  "delivery_mode": "no-mistakes",
  "inputs": {
    "operation": "record_pr",
    "task_branch": "fm/task-x1",
    "kind": "ship",
    "recorded_pr_url": "https://github.com/example/repo/pull/7",
    "recorded_pr_head": "pr_head",
    "pr_url_to_record": "https://github.com/example/repo/pull/7",
    "discard_approval": null
  },
  "forge": {
    "reachable": true,
    "pull_requests": [
      {
        "number": 7,
        "head_ref_name": "fm/task-x1",
        "state": "MERGED",
        "head": "pr_head"
      }
    ]
  },
  "expected": {
    "verdict": "record",
    "reason_class": "forge_pr_head",
    "recorded_pr_head": "pr_head",
    "then_cleanup": {
      "verdict": "refuse",
      "reason_class": "not_in_merged_pr_head"
    }
  },
  "invariants": [
    {
      "check": "same",
      "a": "pr_head",
      "b": "local_head",
      "expect": false
    },
    {
      "check": "ancestor",
      "ref": "pr_head",
      "of": "local_head",
      "expect": true
    },
    {
      "check": "on_remote_tracking",
      "ref": "local_head",
      "expect": false
    },
    {
      "check": "dirty",
      "expect": false
    }
  ]
}

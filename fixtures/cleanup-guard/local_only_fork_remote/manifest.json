{
  "name": "local_only_fork_remote",
  "ported_from": "tests/fm-teardown.test.sh:test_local_only_fork_remote_allows",
  "firstmate_matrix_row": "a",
  "description": "Local-only task whose HEAD (an empty commit) was pushed to a fork remote, not origin. A fork is still a remote: the worktree HEAD is reachable from refs/remotes/fork/fm/task-x1, so cleanup is allowed. Firstmate's pre-fix code false-refused this upstream-contribution flow.",
  "delivery_mode": "local-only",
  "inputs": {
    "operation": "cleanup",
    "task_branch": "fm/task-x1",
    "kind": "ship",
    "recorded_pr_url": null,
    "recorded_pr_head": null,
    "pr_url_to_record": null,
    "discard_approval": null
  },
  "forge": {
    "reachable": true,
    "pull_requests": []
  },
  "expected": {
    "verdict": "allow",
    "reason_class": "on_remote_tracking_branch"
  },
  "invariants": [
    {
      "check": "on_remote_tracking",
      "ref": "local_head",
      "expect": true
    },
    {
      "check": "remote_branch",
      "remote": "fork",
      "branch": "fm/task-x1",
      "expect": true
    },
    {
      "check": "remote_branch",
      "remote": "origin",
      "branch": "fm/task-x1",
      "expect": false
    },
    {
      "check": "same",
      "a": "local_head",
      "b": "fork_branch_head",
      "expect": true
    },
    {
      "check": "ancestor",
      "ref": "local_head",
      "of": "primary_main",
      "expect": false
    },
    {
      "check": "dirty",
      "expect": false
    }
  ]
}

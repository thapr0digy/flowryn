{
  "name": "squash_merged_branch_deleted",
  "ported_from": "tests/fm-teardown.test.sh:test_squash_merged_branch_deleted_allows",
  "firstmate_matrix_row": "g",
  "description": "Squash-merge-then-delete-branch: the task commit (feature.txt) is on no remote-tracking branch and the head branch is gone. The recorded PR (pr= and pr_head= the current HEAD) reads MERGED with head equal to the local HEAD, which is the ONLY landed signal: as in Firstmate, origin/main does not carry the content, so the content fallback cannot rescue this case. Allowed via the merged PR.",
  "delivery_mode": "no-mistakes",
  "inputs": {
    "operation": "cleanup",
    "task_branch": "fm/task-x1",
    "kind": "ship",
    "recorded_pr_url": "https://github.com/example/repo/pull/7",
    "recorded_pr_head": "pr_head",
    "pr_url_to_record": null,
    "discard_approval": null
  },
  "forge": {
    "reachable": true,
    "pull_requests": [
      {
        "number": 7,
        "head_ref_name": "fm/task-x1",
        "state": "MERGED",
        "head": "pr_head"
      }
    ]
  },
  "expected": {
    "verdict": "allow",
    "reason_class": "merged_pr_contains_head"
  },
  "invariants": [
    {
      "check": "on_remote_tracking",
      "ref": "local_head",
      "expect": false
    },
    {
      "check": "remote_branch",
      "remote": "origin",
      "branch": "fm/task-x1",
      "expect": false
    },
    {
      "check": "same",
      "a": "local_head",
      "b": "pr_head",
      "expect": true
    },
    {
      "check": "content_in",
      "ref": "origin_main",
      "expect": false
    },
    {
      "check": "dirty",
      "expect": false
    }
  ]
}
